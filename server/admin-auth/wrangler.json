{
  "name": "personal-profile-admin-auth",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "node build-assets.js" },
  "assets": {
    "directory": "./.assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_ORIGIN": "https://personal-profile-admin-auth.leedidc1227.workers.dev",
    "PUBLIC_ORIGIN": "https://lee.chanhyeong.kro.kr",
    "ADMIN_USERNAME": "classer"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ADMIN_STATE", "class_name": "AdminState" },
      { "name": "VISITOR_STATS", "class_name": "VisitorStats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AdminState"] },
    { "tag": "v2", "new_sqlite_classes": ["VisitorStats"] }
  ],
  "observability": { "enabled": false }
}
